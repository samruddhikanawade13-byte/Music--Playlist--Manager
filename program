
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100

// Doubly Linked List
typedef struct Song {
    char name[50];
    struct Song *prev, *next;
} Song;

Song *head = NULL, *tail = NULL;

// Circular Linked List
typedef struct CircularSong {
    char name[50];
    struct CircularSong *next;
} CircularSong;

CircularSong *cHead = NULL, *current = NULL;

// Stack
char stack[MAX][50];
int top = -1;

// Queue
char queue[MAX][50];
int front = 0, rear = -1, count = 0;

// Add song to doubly linked list
void addSong(char name[]) {
    Song *newSong = malloc(sizeof(Song));
    if (newSong == NULL) return;

    strcpy(newSong->name, name);
    newSong->next = NULL;
    newSong->prev = tail;

    if (head == NULL)
        head = tail = newSong;
    else {
        tail->next = newSong;
        tail = newSong;
    }

    printf("Song added: %s\n", name);
}

// Display all songs
void displaySongs() {
    Song *temp = head;

    printf("\nMusic Playlist:\n");
    if (temp == NULL) {
        printf("Playlist is empty.\n");
        return;
    }

    while (temp != NULL) {
        printf("%s\n", temp->name);
        temp = temp->next;
    }
}

// Delete song
void deleteSong(char name[]) {
    Song *temp = head;

    while (temp != NULL &&
           strcmp(temp->name, name) != 0)
        temp = temp->next;

    if (temp == NULL) {
        printf("Song not found.\n");
        return;
    }

    if (temp->prev)
        temp->prev->next = temp->next;
    else
        head = temp->next;

    if (temp->next)
        temp->next->prev = temp->prev;
    else
        tail = temp->prev;

    free(temp);
    printf("Song deleted: %s\n", name);
}

// Create circular playlist
void createCircularPlaylist() {
    Song *temp = head;

    while (temp != NULL) {
        CircularSong *node =
            malloc(sizeof(CircularSong));

        if (node == NULL) return;

        strcpy(node->name, temp->name);
        node->next = NULL;

        if (cHead == NULL) {
            cHead = node;
            current = node;
        } else {
            CircularSong *last = cHead;
            while (last->next != NULL)
                last = last->next;
            last->next = node;
        }

        temp = temp->next;
    }

    if (cHead != NULL) {
        CircularSong *last = cHead;
        while (last->next != NULL)
            last = last->next;
        last->next = cHead;
    }
}

// Stack: store recently played songs
void pushHistory(char name[]) {
    if (top < MAX - 1)
        strcpy(stack[++top], name);
}

void showHistory() {
    printf("\nRecently Played Songs (Stack):\n");

    if (top == -1) {
        printf("No songs played yet.\n");
        return;
    }

    for (int i = top; i >= 0; i--)
        printf("%s\n", stack[i]);
}

// Queue: add songs to waiting list
void enqueue(char name[]) {
    if (count == MAX) {
        printf("Queue is full.\n");
        return;
    }

    rear = (rear + 1) % MAX;
    strcpy(queue[rear], name);
    count++;

    printf("Song added to queue: %s\n", name);
}

void dequeueSong() {
    if (count == 0) {
        printf("Queue is empty.\n");
        return;
    }

    printf("Playing queued song: %s\n", queue[front]);
    front = (front + 1) % MAX;
    count--;
}

// Play next song from circular playlist
void playNext() {
    if (current == NULL) {
        printf("Create the playlist first.\n");
        return;
    }

    printf("Now Playing: %s\n", current->name);
    pushHistory(current->name);
    current = current->next;
}

int main() {
    int choice;
    char name[50];

    do {
        printf("\n===== MUSIC PLAYLIST MANAGER =====\n");
        printf("1. Add Song\n");
        printf("2. Display Songs\n");
        printf("3. Delete Song\n");
        printf("4. Create Circular Playlist\n");
        printf("5. Play Next Song\n");
        printf("6. Show Recently Played Songs\n");
        printf("7. Add Song to Queue\n");
        printf("8. Play Song from Queue\n");
        printf("9. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1)
            break;

        switch (choice) {
            case 1:
                printf("Enter song name: ");
                scanf(" %49[^\n]", name);
                addSong(name);
                break;

            case 2:
                displaySongs();
                break;

            case 3:
                printf("Enter song name to delete: ");
                scanf(" %49[^\n]", name);
                deleteSong(name);
                break;

            case 4:
                createCircularPlaylist();
                printf("Circular playlist created.\n");
                break;

            case 5:
                playNext();
                break;

            case 6:
                showHistory();
                break;

            case 7:
                printf("Enter song name: ");
                scanf(" %49[^\n]", name);
                enqueue(name);
                break;

            case 8:
                dequeueSong();
                break;

            case 9:
                printf("Exiting Music Playlist Manager.\n");
                break;

            default:
                printf("Invalid choice. Try again.\n");
        }

    } while (choice != 9);

    return 0;
}
